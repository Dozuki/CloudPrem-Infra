*.tfstate*
.terraform*
# The dependency lock file is the exception: it MUST be committed. Without it every
# init resolves the newest version the constraints allow, so a bad provider release
# reaches the whole fleet, Spacelift included, the moment it publishes (aws 6.57.0,
# 2026-07-29). Tracked = provider upgrades arrive as a reviewable diff instead.
!.terraform.lock.hcl
tfplan
terraform.tfstate.d/
**/.terragrunt*
*.tfvars
!terraform/physical-azure/examples/**/*.tfvars
!terraform/logical/examples/**/*.tfvars
tfvars
.idea
*.iml
test_output*
/live/gov/
/live/standard/
/live/logs
/live/logs/

# Azure deploy kit
dist/
azure-config/.bin/
azure-config/.state/
azure-config/*.tfvars
azure-config/ghcr.env
terraform/physical-azure/backend_override.tf
terraform/logical/backend_override.tf
terraform/logical/aws_stub_override.tf

# python bytecode (would otherwise land in the lambda archive and churn source_code_hash)
__pycache__/
*.pyc
