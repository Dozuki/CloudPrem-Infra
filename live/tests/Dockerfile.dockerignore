# BuildKit reads <dockerfile>.dockerignore in preference to a root .dockerignore, which
# keeps this next to the Dockerfile instead of adding a file at the repo root (harness
# changes stay wholly inside live/tests so release-please's exclude-paths still applies).
#
# The build context is the repo root and the local tree carries ~870MB of run residue.
# Excluding it is most of the build's wall time.

.git
.idea
dist

live/tests/.artifacts
live/tests/.logs
live/tests/__worktrees__
live/tests/.bin

# Generated by live/generate_live_env.sh; regenerated inside each worktree at runtime.
live/standard
live/gov

# Local state and caches that must never land in an image layer.
**/.terraform
**/.terragrunt-cache
**/*.tfstate
**/*.tfstate.backup
**/.env
**/*.tfvars
!**/*.tfvars.example

# Docs and dashboards are not part of the runtime.
**/*.md
!live/tests/PHASES.md
loadtest
azure-config
